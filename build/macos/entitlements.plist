<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Erlaubt dynamische Code-Ausführung (JIT) für CPython-Extensions -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <!-- Erforderlich für PySide6/Shiboken und Ctypes Speicherallokationen -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- Zwingend: Erlaubt das Laden von dylibs/.so-Dateien, die nicht mit derselben Team-ID signiert sind -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
