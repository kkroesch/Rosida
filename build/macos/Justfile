MOD_DIR   := justfile_directory()
REPO_ROOT := clean(MOD_DIR / "../..")

SIGN_ID   := "Developer ID Application: Karsten Kroesch (4G75EJQZ5G)"
DIST_DIR  := MOD_DIR / "dist"
APP       := DIST_DIR / "Rosida.app"
RES       := APP / "Contents/Resources"
PY_DIR    := RES / "python"
ENTITLEMENTS := MOD_DIR / "entitlements.plist"
VERSION   := "0.2.0"
DMG_FILE  := DIST_DIR / "Rosida-" + VERSION + "-macos-arm64.dmg"

# Standard-Target im Modul
default: dmg

# Icons aus SVG generieren
icons:
    #!/bin/bash
    set -eo pipefail
    ICONSET="{{MOD_DIR}}/rosida.iconset"
    mkdir -p "$ICONSET"
    for size in 16 32 64 128 256 512 1024; do
        rsvg-convert -w $size -h $size "{{REPO_ROOT}}/logo.svg" -o "$ICONSET/icon_${size}x${size}.png"
    done
    mkdir -p "{{RES}}"
    iconutil -c icns "$ICONSET" -o "{{RES}}/AppIcon.icns"
    rm -rf "$ICONSET"

# App-Struktur anlegen und Skripte kopieren
macapp: icons
    mkdir -p "{{APP}}/Contents/MacOS" "{{RES}}"
    cp -a "{{REPO_ROOT}}"/src/* "{{RES}}/"
    cp "{{MOD_DIR}}/Info.plist" "{{APP}}/Contents/Info.plist"
    cp "{{MOD_DIR}}/launch" "{{APP}}/Contents/MacOS/launch"
    chmod +x "{{APP}}/Contents/MacOS/launch"
    # Handbuch einbacken, damit die "Handbuch"-Aktion und der Erststart-Dialog im Bundle funktionieren
    mkdir -p "{{RES}}/docs"
    cp "{{REPO_ROOT}}/docs/quickstart.md" "{{RES}}/docs/quickstart.md"

# Standalone-Python und Abhängigkeiten in das Bundle installieren
@python: macapp
    #!/bin/bash
    set -eo pipefail

    if [ ! -d "{{PY_DIR}}" ]; then
        echo "Kopiere Standalone-Python..."
        PY_BIN=$(uv python find 3.12)
        PY_ROOT=$(dirname $(dirname "$PY_BIN"))
        mkdir -p "{{PY_DIR}}"
        cp -a "$PY_ROOT/"* "{{PY_DIR}}/"
        rm -f "{{PY_DIR}}"/lib/python3.*/EXTERNALLY-MANAGED
    fi

    echo "Installiere Core-Abhängigkeiten..."
    uv pip install --break-system-packages --python "{{PY_DIR}}/bin/python3" \
        pyside6-essentials sympy matplotlib numpy polars qtawesome

    echo "Entferne Ballast und Build-Tools..."
    rm -rf "{{PY_DIR}}"/lib/python3.*/test
    rm -rf "{{PY_DIR}}"/lib/python3.*/idlelib
    rm -rf "{{PY_DIR}}"/lib/python3.*/turtledemo
    rm -rf "{{PY_DIR}}"/lib/python3.*/ensurepip
    rm -rf "{{PY_DIR}}"/lib/python3.*/site-packages/PySide6/Qt/libexec
    rm -rf "{{PY_DIR}}"/lib/python3.*/site-packages/PySide6/Qt/translations
    rm -rf "{{PY_DIR}}"/lib/python3.*/site-packages/PySide6/scripts
    rm -rf "{{PY_DIR}}"/bin/pyside6-*
    find "{{PY_DIR}}"/lib/python3.*/site-packages -type d \( -name "tests" -o -name "test" \) -prune -exec rm -rf {} +
    find "{{PY_DIR}}" -type f \( -name "*.o" -o -name "*.a" \) -delete

    "{{PY_DIR}}/bin/python3" -c "import PySide6, sympy, matplotlib, numpy, polars, qtawesome; print('OK: Schlanke Runtime bereit')"

# 2. Bundle versiegeln
sign: python
    #!/usr/bin/env bash
    set -euo pipefail

    echo "==> 1. Schreibrechte für alle Dateien erzwingen..."
    chmod -R u+w "{{APP}}"

    echo "==> 2. Quarantäne & Attribute entfernen..."
    xattr -cr "{{APP}}"

    echo "==> 3. Tcl/Tk-Reste entfernen (wird für PySide nicht gebraucht)..."
    rm -rf "{{APP}}/Contents/Resources/python/lib/thread"* || true
    rm -rf "{{APP}}/Contents/Resources/python/lib/tcl"* || true
    rm -rf "{{APP}}/Contents/Resources/python/lib/tk"* || true

    echo "==> 4. Alle Mach-O-Binärdateien finden und einzeln signieren..."
    # Findet ALLE echten Binaries (unabhängig von der Dateiendung)
    while IFS= read -r bin; do
        if file -b "$bin" | grep -q "Mach-O"; then
            echo "Signiere Binary: $bin"
            # Alte Signaturen sauber entfernen
            codesign --remove-signature "$bin" 2>/dev/null || true
            codesign --force --timestamp --options runtime \
                --sign "{{SIGN_ID}}" "$bin"
        fi
    done < <(find "{{APP}}/Contents" -type f)

    echo "==> 5. Gesamtes App-Bundle mit Entitlements versiegeln..."
    codesign --force --timestamp --options runtime \
        --entitlements "{{ENTITLEMENTS}}" \
        --sign "{{SIGN_ID}}" \
        "{{APP}}"

    echo "==> 6. Bundle-Signatur prüfen..."
    codesign --verify --deep --strict --verbose=2 "{{APP}}"

# DMG im dist-Verzeichnis erstellen
dmg: sign
    mkdir -p "{{DIST_DIR}}"
    rm -f "{{DMG_FILE}}"
    create-dmg \
        --volname "Rosida" \
        --window-pos 200 120 \
        --window-size 600 400 \
        --icon-size 100 \
        --icon "Rosida.app" 160 190 \
        --hide-extension "Rosida.app" \
        --app-drop-link 440 190 \
        --no-internet-enable \
        "{{DMG_FILE}}" \
        "{{APP}}"
    codesign --force --timestamp --sign "{{SIGN_ID}}" "{{DMG_FILE}}"

# Notarisieren und Ticket stapeln
notarize: dmg
    xcrun notarytool submit "{{DMG_FILE}}" --keychain-profile "rosida-profile" --wait
    @echo "Warte 15 Sekunden auf Ticket-Bereitstellung im Apple CDN..."
    sleep 15
    xcrun stapler staple "{{DMG_FILE}}"
    spctl --assess --type open --context context:primary-signature --verbose "{{DMG_FILE}}"

build: notarize

clean:
    rm -rf "{{DIST_DIR}}"

release version="0.2.0":
    git tag -a v{{version}} -m "v{{version}}"
    git push origin v{{version}}

    gh release create v{{version}} \
      "{{DMG_FILE}}" \
      --title "Rosida v{{version}}" \
      --notes "Erster signierter macOS-Build (Apple Silicon) mit nativer Polars- und Quarto-Unterstützung."
